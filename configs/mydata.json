{
    "dataset": "mydata",
    "val_split": 0.15,
    "backbone": "resnet50_mydata",
    "feature_layer": "layer4",
    "device": "cuda",
    "num_workers": 4,
    "sae_expansion_factor": 1,
    "sae_l1_coefficient": 0.0001,
    "sae_learning_rate": 0.0001,
    "sae_batch_size": 32,
    "sae_epochs": 1000,
    "sae_patience": 50,
    "sae_ce_drop_tolerance": 0.002,
    "sae_min_active_images": 10,
    "seed": 42,
    "annotation_train_samples": 700,
    "annotation_test_samples": 300,
    "merge_similarity_threshold": 0.98
}
